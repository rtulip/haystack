struct Str {
    &u8: data
    u64: len
}

fn Str.cstr(Str: s) -> [&u8] s::data

impl Print<Str> {
    fn print(Str: s) { 
        "%.*s" Str.cstr
        (s::len s::data)
        printf as [_]
    }
}

impl Print<bool> {
    fn print(bool) if {
        "true" print
    } else {
        "false" print
    }
}