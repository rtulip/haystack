include "basic.hay"
include "c.hay"
include "print.hay"
include "str.hay"
include "operations.hay"

interface Cast<From Into> {
    fn cast(From Type<Into>) -> [Into] __unchecked_cast
}

impl<T> Cast<T T> {}
impl<From Into> Cast<&From &Into> {}
impl<From Into> Cast<&mut.From &mut.Into> {}
impl Cast<bool u8> {}
impl<T> Cast<u64 &mut.T>{}

interface GenericExample<T> {
    fn generic_example<U>(U T) -> [U] drop
}

impl GenericExample<bool> {
    fn generic_example<T>(T bool) -> [T] drop
}

enum Option<T> {
    T: Some
    None
}

fn Some<T>(T) -> [Option<T>::Some] {
    #Option::Some pack
}

fn None<T>() -> [Option<T>::None] {
    #Option::None pack
}

impl<T> Print<Option<T>> 
requires [Print<T>] 
{
    fn print(Option<T>) match {
         Option::Some { 
            "Some(" print 
                    print 
            ")"     print 
        }
        Option::None { "None" print }
    }
}

enum Result<T E> {
    T: Ok
    E: Err
}

fn Ok<T E>(T) -> [Result<T E>::Ok] {
    #Result::Ok pack
}

fn Err<T E>(E) -> [Result<T E>::Err] {
    #Result::Err pack
}
