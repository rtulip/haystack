fn process<T>(T: _) {} 
fn fallback() {}
fn handle_err<E>(E: _) {}

fn example<T E>(Result<Option<T> E>) match {
    Result::Ok match {
        Option::Some process
        Option::None fallback
    }
    Result::Err handle_err
}

fn transform(u64: _) -> [bool] true

fn Str.print_chars(Str: s) {
    0 while dup s->len < do {
        as [i]
        "`%c`\n"c s->data i + |> printf drop
        i 1 + 
    } drop
}

fn main() {
    12345 Option.Some &transform Option.map println
    Option.None &transform Option.map println
    false println
    "Hello World" println
    12345 println
    
    1 2 + println
    0xFF println
    
    "Hello World" Str.print_chars

}