impl Print<u64> {
    fn print(u64) {
        "%lu"c swap printf drop
    }
    fn println(u64) {
        "%lu\n"c swap printf drop
    }
}

impl Add<u64 u64> {
    u64: Output
    fn add(u64 u64) -> [u64] __u64_add
}

impl Sub<u64 u64> {
    u64: Output
    fn sub(u64 u64) -> [u64] __u64_sub
}

impl Mul<u64 u64> {
    u64: Output
    fn mul(u64 u64) -> [u64] __u64_mul
}

impl Compare<u64 u64> {
    fn eq(u64 u64) -> [bool] __u64_eq
    fn lt(u64 u64) -> [bool] __u64_lt
}