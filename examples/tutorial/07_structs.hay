include "prelude.hay"

struct Pair {
    u64: left
    u64: right
}

fn Pair.new(u64: left u64: right) -> [Pair] {
    left right #Pair pack
}

fn Pair.left(Pair: p) -> [u64] p::left
fn Pair.right(Pair: p) -> [u64] p::right
fn Pair.split(Pair) -> [u64 u64] unpack


fn main() {
    1 2 Pair.new as [pair]
    "left:  " print pair Pair.left println
    "right: " print pair Pair.right println
    pair Pair.split
    "right: " print println
    "left:  " print println
}