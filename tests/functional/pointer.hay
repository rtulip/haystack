fn new<T>(Type<T>) -> [&mut.T] {
    sizeof __null swap realloc #&mut.T cast
}

fn free<T>(&mut.T) {
    #&mut.u8 cast
    0 realloc drop
}

fn main() {

    {
        #u64 new as [ptr]
        12345 ptr |<
        ptr |> println

        54321 ptr |<
        ptr |> println

        ptr 
    } 
    free
}