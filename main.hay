fn drop<T>(T: _) { }
fn dup<T>(T: t) -> [T T] { t t }
fn typeof<T>(T: _) -> [Type<T>] #T
fn hint<T>(T Type<T>) -> [T] drop

interface Cast<From Into> {
    fn cast<From Into>(From Type<Into>) -> [Into] __unchecked_cast
}

impl<T> Cast<T T> {}
impl<From Into> Cast<&From &Into> {}
impl Cast<bool u8> {}

struct Str {
    &u8: data
    u64: len
}

enum Option<T> {
    T: Some
    None
}

fn Some<T>(T) -> [Option<T>::Some] {
    #Option::Some pack
}

fn None<T>() -> [Option<T>::None] {
    #Option::None pack
}

enum Result<T E> {
    T: Ok
    E: Err
}

fn Ok<T E>(T) -> [Result<T E>::Ok] {
    #Result::Ok pack
}

fn Err<T E>(E) -> [Result<T E>::Err] {
    #Result::Err pack
}



interface Foo<T> {
    fn a<T>(T) drop
    fn b<T>(T) drop
}

impl<T> Foo<T> {
    fn a(T) {
        as [_]
        "inside A" drop
    }
}

impl Foo<u64> {
    fn b(u64) {
        drop
        "Inside Foo<u64> B" drop
    }
}

fn main() {

    true as [b]
    &b #&u8 cast

    true #u8 cast
}