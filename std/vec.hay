struct Vec<T> {
    Slice<T>: slice
    u64: len
}

fn Vec.new<T>() -> [Vec<T>] {
    __null 0 #Slice pack 
    0 
    #Vec pack
}

fn Vec.push<T>(T: val &mut.Vec<T>: self) {

    self->len self->slice->cap == if {
        &mut.self->slice Slice.resize
    }

    val self->slice->data self->len + |<

    self->len 1 + &mut.self->len |<

}

fn Vec.get<T>(u64: n &Vec<T>: self) -> [Option<T>] {  
    n self->len < if {
        n self->slice Slice.get
    } else {
        Option.None
    }
}