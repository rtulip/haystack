struct Str {
    &char: data
    u64: len
}

fn Str.cstr(Str) -> [&char] ::data

fn bool.to_str(bool) -> [Str] if { "true" } else { "false" }

impl Print<Str> {
    fn print(Str: s) { 
        "%.*s"c (s::len s::data) printf drop
    }
    fn println(Str: s) {
        "%.*s\n"c (s::len s::data) printf drop
    }
}

impl Print<bool> {
    fn print(bool) {
        bool.to_str print
    }
}

impl Print<u64> {
    fn print(u64) {
        "%lu"c swap printf drop
    }
    fn println(u64) {
        "%lu\n"c swap printf drop
    }
}

impl Print<u8> {
    fn print(u8) {
        "%u"c swap printf drop
    }

    fn println(u8) {
        "%u\n"c swap printf drop
    }
}

impl Print<char> {
    fn print(char){
        "%c"c swap printf drop
    }

    fn println(char){
        "%c\n"c swap printf drop
    }
}

impl Print<()> {
    fn print(()) {
        "()"c swap printf drop
    }
}