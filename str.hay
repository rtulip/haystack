struct Str {
    &u8: data
    u64: len
}

fn Str.cstr(Str: s) -> [&u8] s::data

fn bool.to_str(bool) -> [Str] if { "true" } else { "false" }

impl Print<Str> {
    fn print(Str: s) { 
        "%.*s" Str.cstr
        (s::len s::data)
        printf as [_]
    }
}

impl Print<bool> {
    fn print(bool) {
        bool.to_str print
    }
}

impl Print<u64> {
    fn print(u64) {
        "%llu" Str.cstr swap printf drop
    }
}

impl Print<u8> {
    fn print(u8) {
        "%u" Str.cstr swap printf drop
    }
}

impl Print<char> {
    fn print(char){
        "%c" Str.cstr swap printf drop
    }
}

