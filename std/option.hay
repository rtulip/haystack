enum Option<T> {
    T: Some
    None
}

impl<T> Print<Option<T>> 
requires [Print<T>] 
{
    fn print(Option<T>) match {
         Option::Some { 
            "Some(" print 
                    print 
            ")"     print 
        }
        Option::None { "None" print }
    }
}

fn Option.Some<T>(T) -> [Option<T>::Some] { #Option::Some pack }
fn Option.None<T>() -> [Option<T>::None] { #Option::None pack }

fn Option.is_none<T>(Option<T>) -> [bool] match {
    Option::None true
    else         false
}

fn Option.unwrap<T>(Option<T>) -> [T] match {
    Option::Some {}
    Option::None { 1 exit }
}

fn Option.unwrap_or<T>(T Option<T>) -> [T] match {
    Option::Some { swap drop }
    Option::None {}
}

fn Option.map<T U>(Option<T>: opt fn(T) -> [U]: f) -> [Option<U>] {
    opt match {
        Option::Some { f Option.Some }
        Option::None Option.None 
    }
}