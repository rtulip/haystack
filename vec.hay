include "prelude.hay" 

struct Slice<T> {
    &mut.T: data
    u64: cap
}

fn __null<T>() -> [&mut.T] {
    0 #&mut.T cast
}

fn Slice.new_size(u64: cap) -> [u64] {
    cap 0 == if {
        8
    } else {
        cap 2 *
    }
}

fn Slice.resize<T>(&mut.Slice<T>: self) {

    self::cap Slice.new_size as [new_cap]

    (self::data #&mut.u8 cast)
    (new_cap #T sizeof *) 
    realloc #&mut.T cast
    
    new_cap
    #Slice pack self |<

}

fn Slice.get<T>(u64: n Slice<T>: self) -> [Option<T>] {
    n self::cap < if {
        self::data n + |> Option.Some    
    } else {
        Option.None
    }
}

struct Vec<T> {
    Slice<T>: slice
    u64: len
}

fn Vec.new<T>() -> [Vec<T>] {
    __null 0 #Slice pack 
    0 
    #Vec pack
}

fn Vec.push<T>(T: val &mut.Vec<T>: self) {

    self::len self::slice::cap == if {
        &mut.self::slice Slice.resize
    }

    val self::slice::data self::len + |<

    self::len 1 + &mut.self::len |<

}

fn Vec.get<T>(u64: n &Vec<T>: self) -> [Option<T>] {  
    n self::len < if {
        n self::slice Slice.get
    } else {
        Option.None
    }
}

fn main() {

    Vec.new as [v]

    0 while dup 10 < do {
        as [i]
        i 2 * &mut.v Vec.push
        i 1 +
    } drop

    0 while dup 12 < do {
        as [i]
        i &v Vec.get println
        i 1 +
    } drop

    "Capacity: " print v ::slice::cap println
    "Length:   " print v ::len println
}